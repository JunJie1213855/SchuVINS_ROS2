Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 50
  - Class: rviz_default_plugins/Path
    Name: Trajectory
    Enabled: true
    Topic:
      Value: /svo/path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Color: 0; 255; 128
    Line Style: Lines
    Line Width: 0.03
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
  - Class: rviz_default_plugins/Image
    Name: Stereo feature tracks (cam0 | cam1)
    Enabled: true
    Topic:
      Value: /svo/tracked_image
      Depth: 2
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PointCloud2
    Name: All historical landmarks (XYZRGB)
    Enabled: true
    Style: Points
    Size (Pixels): 3
    Size (m): 0.02
    Color Transformer: RGB8
    Position Transformer: XYZ
    Decay Time: 0
    Topic:
      Value: /svo/landmarks
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
Window Geometry:
  Width: 1200
  Height: 800
